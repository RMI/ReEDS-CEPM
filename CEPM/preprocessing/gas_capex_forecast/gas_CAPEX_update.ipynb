   "source": [
     "from pathlib import Path\n",
     "import pandas as pd\n",
     "\n",
     "REPO_ROOT = Path.cwd().resolve()\n",
     "while not (REPO_ROOT / \"runreeds.py\").exists() and REPO_ROOT != REPO_ROOT.parent:\n",
     "    REPO_ROOT = REPO_ROOT.parent\n",
     "\n",
     "ATB_PATH = REPO_ROOT / \"inputs/plant_characteristics/gas_ATB_2024_moderate.csv\"\n",
     "\n",
     "ccgt_forecast = pd.read_csv(\"ccgt_regression_forecast.csv\").set_index(\"Year\")\n",
     "ct_forecast = pd.read_csv(\"ct_regression_forecast.csv\").set_index(\"Year\")[\"Cost_$/kW\"]\n",
     "years = ccgt_forecast.index\n",
     "\n"
    "ccgt_forecast"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "76598fe6",
   "metadata": {},
   "source": [
    "## Build the 3 csv versions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "239070eb",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T17:08:23.837994Z",
     "iopub.status.busy": "2026-07-28T17:08:23.837912Z",
     "iopub.status.idle": "2026-07-28T17:08:23.840827Z",
     "shell.execute_reply": "2026-07-28T17:08:23.840649Z"
    }
   },
   "outputs": [],
   "source": [
    "atb_base = pd.read_csv(ATB_PATH)\n",
    "\n",
    "def make_version(ccgt_col, out_path):\n",
    "    atb = atb_base.copy()\n",
    "\n",
    "    is_cc_forecast_years = (atb[\"i\"] == \"Gas-CC\") & (atb[\"t\"].isin(years))\n",
    "    atb.loc[is_cc_forecast_years, \"capcost\"] = atb.loc[is_cc_forecast_years, \"t\"].map(ccgt_forecast[ccgt_col]).values\n",
    "\n",
    "    is_ct_forecast_years = (atb[\"i\"] == \"Gas-CT\") & (atb[\"t\"].isin(years))\n",
    "    atb.loc[is_ct_forecast_years, \"capcost\"] = atb.loc[is_ct_forecast_years, \"t\"].map(ct_forecast).values\n",
    "\n",
    "    atb.to_csv(out_path, index=False)\n",
    "    return atb[(atb[\"i\"].isin([\"Gas-CC\", \"Gas-CT\"])) & (atb[\"t\"].isin(years))]"
   ]
  },
